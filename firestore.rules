rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function own(uid) { return signedIn() && request.auth.uid == uid; }
    function queueOwner(qid) {
      return signedIn() &&
        get(/databases/$(database)/documents/queues/$(qid)).data.storeId == request.auth.uid;
    }
    function queueMember(qid) {
      return signedIn() &&
        exists(/databases/$(database)/documents/activeMemberships/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/activeMemberships/$(request.auth.uid)).data.queueId == qid;
    }
    function customerOwner(uid) {
      return signedIn() &&
        exists(/databases/$(database)/documents/activeMemberships/$(uid)) &&
        queueOwner(get(/databases/$(database)/documents/activeMemberships/$(uid)).data.queueId);
    }
    function validUser(uid) {
      let d = request.resource.data;
      return d.keys().hasOnly(['id','name','email','phoneNumber','isAnonymous','fcmToken']) &&
        d.id == uid && d.name is string && d.name.size() > 0 && d.name.size() <= 100 &&
        d.email == request.auth.token.email &&
        d.get('phoneNumber', '') is string && d.get('phoneNumber', '').size() <= 30 &&
        d.get('fcmToken', null) == null && d.get('isAnonymous', false) == false;
    }
    function validStore(uid) {
      let d = request.resource.data;
      return d.keys().hasOnly(['id','name','businessName','businessType','phoneNumber','address',
          'email','isVerified','registrationDate']) &&
        d.id == uid && d.name is string && d.name.size() > 0 && d.name.size() <= 100 &&
        d.businessName is string && d.businessName.size() > 0 && d.businessName.size() <= 100 &&
        d.businessType is string && d.businessType.size() <= 100 &&
        d.phoneNumber is string && d.phoneNumber.size() <= 30 &&
        d.address is string && d.address.size() <= 500 &&
        d.email == request.auth.token.email && d.get('isVerified', false) is bool;
    }
    match /customers/{uid} {
      allow get: if own(uid) || customerOwner(uid);
      allow list: if false;
      allow create, update: if own(uid) && validUser(uid);
      allow delete: if false;
    }
    match /stores/{uid} {
      allow get: if own(uid);
      allow list: if false;
      allow create: if own(uid) && validStore(uid) &&
        request.resource.data.get('isVerified', false) == false;
      allow update: if own(uid) && validStore(uid) &&
        request.resource.data.get('isVerified', false) == resource.data.get('isVerified', false);
      allow delete: if false;
    }
    match /queues/{qid} {
      allow read: if signedIn();
      allow write: if false;
      match /tickets/{ticketId} {
        allow read: if queueOwner(qid) || queueMember(qid);
        allow write: if false;
      }
    }
    match /queueRuntime/{qid} {
      // Only aggregate timing and opaque ticket IDs; no names/contact details.
      allow read: if signedIn();
      allow write: if false;
    }
    match /activeMemberships/{uid} {
      allow get: if own(uid);
      allow list, write: if false;
    }
    match /queueHistory/{qid}/visits/{visitId} {
      allow read: if queueOwner(qid) ||
        (signedIn() && resource.data.userId == request.auth.uid);
      allow write: if false;
    }
    match /{document=**} { allow read, write: if false; }
  }
}
